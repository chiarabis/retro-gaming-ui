//NOTES FOR IMPLEMENTING POKEMON CARD

interface Pokemon {
  id: number
  name: string
  sprites: {
    front_default: string
  }
  types: {
    type: {
      name: string
    }
  }[]
  evolutions: Evolution[]
}

interface Evolution {
  name: string
  image: string
}


function App() {
  const [pokemons, setPokemons] = useState<Pokemon[]>([])
  const [types, setTypes] = useState<string[]>([])
  const [selectedType, setSelectedType] = useState("")

  /* -------------------- FETCH TYPES -------------------- */
  useEffect(() => {
    fetch("https://pokeapi.co/api/v2/type")
      .then((r) => r.json())
      .then((d) => setTypes(d.results.map((t: any) => t.name)))
  }, [])

  /* -------------------- EVOLUTIONS -------------------- */
  const getEvolutions = async (id: number): Promise<Evolution[]> => {
    const speciesRes = await fetch(
      `https://pokeapi.co/api/v2/pokemon-species/${id}`
    )
    const speciesData = await speciesRes.json()

    const evoRes = await fetch(speciesData.evolution_chain.url)
    const evoData = await evoRes.json()

    const evolutions: Evolution[] = []
    let current = evoData.chain

    while (current) {
      const name = current.species.name
      const pokeRes = await fetch(
        `https://pokeapi.co/api/v2/pokemon/${name}`
      )
      const pokeData = await pokeRes.json()

      evolutions.push({
        name,
        image: pokeData.sprites.front_default,
      })

      current = current.evolves_to[0]
    }

    return evolutions
  }

  /* -------------------- BUILD POKEMON -------------------- */
  const buildPokemon = async (url: string): Promise<Pokemon> => {
    const data = await fetch(url).then((r) => r.json())
    const evolutions = await getEvolutions(data.id)

    return {
      ...data,
      evolutions: evolutions.filter(
        (e) => e.name !== data.name
      ),
    }
  }

  /* -------------------- DEFAULT -------------------- */
  const fetchDefaultPokemons = async () => {
    const promises = Array.from({ length: 9 }, (_, i) =>
      buildPokemon(`https://pokeapi.co/api/v2/pokemon/${i + 1}`)
    )
    setPokemons(await Promise.all(promises))
  }

  /* -------------------- BY TYPE -------------------- */
  const fetchPokemonsByType = async (type: string) => {
    if (!type) {
      fetchDefaultPokemons()
      return
    }

    const res = await fetch(`https://pokeapi.co/api/v2/type/${type}`)
    const data = await res.json()

    const promises = data.pokemon
      .slice(0, 9)
      .map((p: any) => buildPokemon(p.pokemon.url))

    setPokemons(await Promise.all(promises))
  }

  useEffect(() => {
    fetchDefaultPokemons()
  }, [])

  /* -------------------- UI -------------------- */
  return (
    <div style={{ backgroundColor: "#f1f5f9", padding: "1.5rem" }}>
      <h1 style={{ fontSize: "1.875rem", fontWeight: "bold", marginBottom: "1.5rem" }}>Pokédex</h1>

      {/* FILTER */}
      <select
        value={selectedType}
        onChange={(e) => {
          setSelectedType(e.target.value)
          fetchPokemonsByType(e.target.value)
        }}
        style={{ marginBottom: "1.5rem", padding: "0.5rem 1rem", borderRadius: "0.5rem", border: "1px solid #cbd5e1" }}
      >
        <option value="">All Types</option>
        {types.map((t) => (
          <option key={t} value={t}>
            {t}
          </option>
        ))}
      </select>

      {/* CARDS */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(16rem, 1fr))", gap: "1.5rem" }}>
        {pokemons.map((pokemon) => (
          <div
            key={pokemon.id}
            style={{ backgroundColor: "#ffffff", borderRadius: "12px", boxShadow: "0 4px 6px rgba(0,0,0,0.1)", padding: "1rem", width: "auto" }}
          >
            {/* TYPES */}
            <div style={{ display: "flex", gap: "0.5rem", justifyContent: "center", marginBottom: "0.5rem" }}>
              {pokemon.types.map((t) => (
                <span
                  key={t.type.name}
                  style={{ fontSize: "0.75rem", padding: "0.25rem 0.5rem", borderRadius: "9999px", backgroundColor: "#e2e8f0", textTransform: "capitalize" }}
                >
                  {t.type.name}
                </span>
              ))}
            </div>

            {/* MAIN */}
            <img
              src={pokemon.sprites.front_default}
              alt={pokemon.name}
              style={{ display: "block", margin: "0 auto" }}
            />
            <h2 style={{ fontSize: "1.25rem", fontWeight: "bold", textAlign: "center", marginBottom: "0.5rem" }}>
              {pokemon.name}
            </h2>

            {/* SLIDER EVOLUTIONS */}
            {pokemon.evolutions.length > 0 && (
              <div style={{ display: "flex", justifyContent: "center", gap: "0.75rem", overflowX: "auto", marginTop: "0.5rem", paddingBottom: "0.5rem" }}>
                {pokemon.evolutions.map((evo) => (
                  <div
                    key={evo.name}
                    style={{ minWidth: "90px", backgroundColor: "#e2e8f0", borderRadius: "8px", padding: "0.5rem", textAlign: "center", flexShrink: 0 }}  
                  >
                    <img
                      src={evo.image}
                      alt={evo.name}
                      style={{ display: "block", margin: "0 auto" }}
                    />
                    <p style={{ fontSize: "0.75rem", marginTop: "0.25rem", textTransform: "capitalize" }}>
                      {evo.name}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )
}

export default App;
